<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Reqwa Colors design tokens.
      Near-black surfaces, purple accents. Theme is forced Dark app-wide.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">

            <!-- ===================== Core palette ===================== -->
            <Color x:Key="AppBgColor">#08080B</Color>
            <Color x:Key="AppBg2Color">#0C0C11</Color>
            <Color x:Key="PanelColor">#101016</Color>
            <Color x:Key="PanelHoverColor">#15151D</Color>
            <Color x:Key="PanelActiveColor">#14101C</Color>
            <Color x:Key="BorderColor">#24242D</Color>
            <Color x:Key="BorderStrongColor">#33333F</Color>
            <Color x:Key="DividerColor">#1A1A22</Color>

            <Color x:Key="PrimaryPurpleColor">#8B5CF6</Color>
            <Color x:Key="BrightPurpleColor">#A855F7</Color>
            <Color x:Key="LightPurpleColor">#C084FC</Color>
            <Color x:Key="DeepPurpleColor">#7C3AED</Color>

            <Color x:Key="TextPrimaryColor">#F5F5F7</Color>
            <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
            <Color x:Key="TextMutedColor">#71717A</Color>

            <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}" />
            <SolidColorBrush x:Key="AppBg2Brush" Color="{StaticResource AppBg2Color}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="PanelHoverBrush" Color="{StaticResource PanelHoverColor}" />
            <SolidColorBrush x:Key="PanelActiveBrush" Color="{StaticResource PanelActiveColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

            <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryPurpleColor}" />
            <SolidColorBrush x:Key="BrightPurpleBrush" Color="{StaticResource BrightPurpleColor}" />
            <SolidColorBrush x:Key="LightPurpleBrush" Color="{StaticResource LightPurpleColor}" />
            <SolidColorBrush x:Key="DeepPurpleBrush" Color="{StaticResource DeepPurpleColor}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

            <!-- Subtle purple glow / tint layers -->
            <SolidColorBrush x:Key="PurpleGlowBrush" Color="#2E8B5CF6" />
            <SolidColorBrush x:Key="PurpleHoverBorderBrush" Color="#558B5CF6" />
            <SolidColorBrush x:Key="PurpleSubtleFillBrush" Color="#1A8B5CF6" />
            <SolidColorBrush x:Key="PurpleSubtleHoverBrush" Color="#268B5CF6" />

            <!--
              ===================== Slider theming =====================
              These keys are consumed by the WinUI Slider template; overriding
              them re-skins every slider in the app without custom templates.
            -->
            <SolidColorBrush x:Key="SliderTrackFill" Color="#24242D" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#2B2B36" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#24242D" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#1A1A22" />
            <SolidColorBrush x:Key="SliderTrackFillNotInteractable" Color="#24242D" />
            <SolidColorBrush x:Key="SliderTrackFillNotInteractableDisabled" Color="#1A1A22" />

            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource PrimaryPurpleColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource BrightPurpleColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource BrightPurpleColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#3A3A47" />
            <SolidColorBrush x:Key="SliderTrackValueFillNotInteractable" Color="#4C3B77" />
            <SolidColorBrush x:Key="SliderTrackValueFillNotInteractableDisabled" Color="#3A3A47" />

            <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource BrightPurpleColor}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource LightPurpleColor}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource PrimaryPurpleColor}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#3A3A47" />
            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="{StaticResource BrightPurpleColor}" />

            <SolidColorBrush x:Key="SliderTrackStroke" Color="#2B2B36" />
            <SolidColorBrush x:Key="SliderTrackStrokePointerOver" Color="#33333F" />
            <SolidColorBrush x:Key="SliderTrackStrokePressed" Color="#2B2B36" />
            <SolidColorBrush x:Key="SliderTrackStrokeDisabled" Color="#1A1A22" />
            <SolidColorBrush x:Key="SliderTrackStrokeNotInteractable" Color="#2B2B36" />
            <SolidColorBrush x:Key="SliderTrackStrokeNotInteractableDisabled" Color="#1A1A22" />

            <SolidColorBrush x:Key="SliderHeaderForeground" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="SliderHeaderForegroundDisabled" Color="{StaticResource TextMutedColor}" />

            <!--
              ===================== ToggleSwitch theming =====================
            -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource PrimaryPurpleColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource BrightPurpleColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource DeepPurpleColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource PrimaryPurpleColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource BrightPurpleColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource DeepPurpleColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#1C1C25" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#24242F" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#1C1C25" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#33333F" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#3D3D4B" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#33333F" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#A1A1AA" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#D4D4DC" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#A1A1AA" />
            <SolidColorBrush x:Key="ToggleSwitchContentForeground" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="ToggleSwitchContentForegroundDisabled" Color="{StaticResource TextMutedColor}" />

            <!--
              ===================== CheckBox theming =====================
            -->
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource PrimaryPurpleColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource BrightPurpleColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource DeepPurpleColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource PrimaryPurpleColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource BrightPurpleColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource DeepPurpleColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="#12121A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#191922" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="#12121A" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#33333F" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#3D3D4B" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#33333F" />
            <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="CheckBoxForegroundDisabled" Color="{StaticResource TextMutedColor}" />

            <!--
              ===================== Default Button theming =====================
              Gives ghost/secondary buttons the dark Reqwa look by default.
            -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#14141B" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1B1B25" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#101016" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#101016" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource BorderStrongColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#2B2B36" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#1A1A22" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource TextMutedColor}" />

        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>