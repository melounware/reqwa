<UserControl
    x:Class="ReqwaColors.Views.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:ReqwaColors.Controls"
    xmlns:models="using:ReqwaColors.Models"
    xmlns:vm="using:ReqwaColors.ViewModels"
    mc:Ignorable="d">

    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="24">

        <!-- ===== Header ===== -->
        <StackPanel Spacing="4">
            <TextBlock Text="Main" Style="{StaticResource PageTitleStyle}" />
        </StackPanel>

        <!-- ===== Monitor selector ===== -->
        <ItemsControl x:Name="MonitorsList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="12" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MonitorCardItem">
                    <Button Click="OnMonitorClicked"
                            Background="{x:Bind BgBrush, Mode=OneWay}"
                            BorderBrush="{x:Bind RingBrush, Mode=OneWay}"
                            BorderThickness="1.5"
                            CornerRadius="{StaticResource CardCorner}"
                            Padding="16,12" MinWidth="220"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            PointerEntered="OnMonitorPointerEntered"
                            PointerExited="OnMonitorPointerExited">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Monitor icon -->
                            <Viewbox Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{ThemeResource PrimaryBrush}" Opacity="0.16"
                                          Data="M3,4 L21,4 L21,16 L3,16 Z" />
                                    <Path Stroke="{ThemeResource LightPurpleBrush}" StrokeThickness="1.6"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M3,4 L21,4 L21,16 L3,16 Z M12,16 L12,19.5 M7.5,20 L16.5,20" />
                                </Canvas>
                            </Viewbox>

                            <!-- Role: Primary / Secondary, next to the icon -->
                            <TextBlock Grid.Column="1" Text="{x:Bind RoleLabel}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{ThemeResource LightPurpleBrush}" />

                            <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ResolutionLabel}" FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Color controls card ===== -->
        <Border Style="{StaticResource PanelBorderStyle}">
            <StackPanel Spacing="16">
                <TextBlock Text="DISPLAY COLORS" Style="{StaticResource CardTitleStyle}" />

                <controls:ColorSlider Title="Brightness"
                                      Minimum="50" Maximum="150"
                                      Step="1" Format="0 '％'"
                                      Value="{x:Bind Vm.DisplayPage.Draft.Brightness, Mode=TwoWay}" />

                <controls:ColorSlider Title="Contrast"
                                      Minimum="50" Maximum="150"
                                      Step="1" Format="0 '％'"
                                      Value="{x:Bind Vm.DisplayPage.Draft.Contrast, Mode=TwoWay}" />

                <controls:ColorSlider Title="Gamma"
                                      Minimum="0.5" Maximum="2.5"
                                      Step="0.01" Format="0.00"
                                      Value="{x:Bind Vm.DisplayPage.Draft.Gamma, Mode=TwoWay}" />

                <!-- Advanced: RGB channels + temperature -->
                <StackPanel x:Name="AdvancedPanel" Spacing="16"
                            Visibility="Collapsed">
                    <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" Margin="0,4,0,0" />
                    <controls:ColorSlider Title="Red"
                                          Minimum="0" Maximum="200" Step="1" Format="0 '％'"
                                          Value="{x:Bind Vm.DisplayPage.Draft.Red, Mode=TwoWay}" />
                    <controls:ColorSlider Title="Green"
                                          Minimum="0" Maximum="200" Step="1" Format="0 '％'"
                                          Value="{x:Bind Vm.DisplayPage.Draft.Green, Mode=TwoWay}" />
                    <controls:ColorSlider Title="Blue"
                                          Minimum="0" Maximum="200" Step="1" Format="0 '％'"
                                          Value="{x:Bind Vm.DisplayPage.Draft.Blue, Mode=TwoWay}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch Grid.Column="0" x:Name="TempToggle"
                                      OnContent="" OffContent=""
                                      IsOn="{x:Bind Vm.DisplayPage.Draft.TemperatureEnabled, Mode=TwoWay}"
                                      Margin="0,0,0,-6"
                                      MinWidth="0" />
                        <Slider Grid.Column="1" x:Name="TempSlider"
                                Minimum="2500" Maximum="9500"
                                StepFrequency="100"
                                Value="{x:Bind Vm.DisplayPage.Draft.Temperature, Mode=TwoWay}"
                                IsEnabled="{x:Bind Vm.DisplayPage.Draft.TemperatureEnabled, Mode=OneWay}"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind FormatKelvin(Vm.DisplayPage.Draft.Temperature), Mode=OneWay}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource LightPurpleBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Temperature — warm (2500 K) to cool (9500 K)."
                               Style="{StaticResource MutedTextStyle}" Margin="0,-8,0,0" />
                </StackPanel>

                <ToggleButton x:Name="AdvancedToggle" Content="Advanced controls"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{ThemeResource TextSecondaryBrush}"
                              FontSize="12" FontWeight="SemiBold"
                              Padding="4,4" Click="OnAdvancedToggle">
                    <ToggleButton.Resources>
                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#33333F" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#33333F" />
                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#33333F" />
                    </ToggleButton.Resources>
                </ToggleButton>

                <!-- Actions -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Reset"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{x:Bind Vm.DisplayPage.ResetCommand}" />
                    <Button Grid.Column="2" Content="Apply Changes"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Bind Vm.DisplayPage.ApplyCommand}" />
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>