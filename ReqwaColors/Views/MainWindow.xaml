<Window
    x:Class="ReqwaColors.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:ReqwaColors.Views"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Custom title bar ===== -->
        <Grid Grid.Row="0" x:Name="AppTitleBar" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" Spacing="10">
                <TextBlock Text="Reqwa Colors"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ===== Body: sidebar + content ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{ThemeResource AppBg2Brush}"
                    BorderBrush="{ThemeResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="12,8,12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="2" Margin="0,4,0,0">
                        <TextBlock Text="GENERAL"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="14,8,0,6" />
                        <RadioButton x:Name="NavDisplay" GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                     IsChecked="True"
                                     Command="{x:Bind ViewModel.NavigateCommand}" CommandParameter="Display"
                                     Content="Main" />
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                     Command="{x:Bind ViewModel.NavigateCommand}" CommandParameter="Presets"
                                     Content="Presets" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Spacing="2">
                        <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" Margin="14,6,14,10" />
                        <TextBlock Text="SYSTEM"
                                   Style="{StaticResource SectionHeaderStyle}"
                                   Margin="14,0,0,6" />
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                     Command="{x:Bind ViewModel.NavigateCommand}" CommandParameter="Settings"
                                     Content="Settings" />
                        <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                     Command="{x:Bind ViewModel.NavigateCommand}" CommandParameter="About"
                                     Content="About" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page host -->
            <Grid Grid.Column="1">
                <ScrollViewer Padding="{StaticResource PagePadding}">
                    <ContentControl x:Name="PageHost"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Top"
                                    IsTabStop="False" />
                </ScrollViewer>

                <!-- Toast -->
                <Border x:Name="ToastBorder"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,8,0"
                        Background="#1A12151D"
                        BorderBrush="{ThemeResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,9"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Ellipse Width="7" Height="7" x:Name="ToastDot" Fill="{ThemeResource BrightPurpleBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="ToastText" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>