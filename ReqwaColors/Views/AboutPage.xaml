<UserControl
    x:Class="ReqwaColors.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="{StaticResource SpacingXL}">

        <StackPanel Spacing="4">
            <TextBlock Text="About" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Reqwa Colors — display color control for Windows."
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <Border Style="{StaticResource PanelBorderStyle}">
            <StackPanel Spacing="{StaticResource SpacingL}">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Reqwa Colors" Style="{StaticResource CardTitleStyle}" FontSize="17" />
                    <TextBlock Text="{x:Bind VersionText, Mode=OneTime}"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>

                <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" />

                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"
                           Text="Adjust brightness, contrast, gamma and color temperature per monitor using the Windows gamma ramp. Settings apply instantly and can be saved as presets." />

                <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"
                           Text="Adjustments use the Windows gamma ramp: brightness, contrast, gamma, RGB channel gains and color temperature. GPU-level digital vibrance (saturation) is not exposed by any public Windows API and is therefore not modified." />

                <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" />

                <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"
                           Text="Built with WinUI 3 and .NET. All settings are stored locally; the app makes no network requests." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>